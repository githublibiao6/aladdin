    <sql id="baseColumn">
        t.user_id,
        t.chat_kind,
        t.chat_id,
        t.chat_name,
        t.unread_count,
        t.last_message,
        t.picture_url,
        t.send_time,
        t.chat_label,
        t.top,
        t.status,
